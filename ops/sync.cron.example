# Example crontab for a single VPS that hosts both the jobs and the site.
# Jobs write data/sclyio.db; the web server opens it read-only. The rebuild
# publishes atomically (one transaction flips the published build pointer).
#
# m  h  dom mon dow  command
17   9  *   *   *    cd /srv/sclyio && npm run sync >> logs/sync.log 2>&1 && npm run ratings:rebuild >> logs/rebuild.log 2>&1
