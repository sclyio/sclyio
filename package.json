{
  "name": "sclyio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "accounts:migrate": "tsx scripts/accounts-migrate.ts",
    "import": "tsx scripts/import.ts",
    "sync": "tsx scripts/import.ts --incremental",
    "ratings:rebuild": "tsx scripts/rebuild.ts",
    "backtest": "tsx scripts/backtest.ts",
    "setup": "npm run db:migrate && npm run accounts:migrate && npm run import && npm run ratings:rebuild",
    "sync:all": "npm run sync && npm run ratings:rebuild",
    "db:export": "tsx scripts/export-db.ts",
    "publish:turso": "tsx scripts/publish-turso.ts",
    "personal:recompute": "tsx scripts/personal-recompute.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "js-yaml": "^4.3.2",
    "next": "16.3.6",
    "openid-client": "^6.8.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sciolyff": "^0.20.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "unrs-resolver": true
  }
}
