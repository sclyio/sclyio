# scly.io configuration. Copy to .env.local (Next.js) or export in the job shell.
# Browsing needs no secrets. Google sign-in needs the "Accounts" section below.

# --- Web app data source (first match wins) ---------------------------------
# 1. Turso (production): the app resolves the active dataset from the meta DB.
# TURSO_META_URL=libsql://sclyio-meta-<org>.<region>.turso.io
# TURSO_READ_TOKEN=            # read-only GROUP token (turso group tokens create <group> --read-only)
# 2. Any libSQL URL directly:
# DATABASE_URL=libsql://...  (or file:./data/sclyio.db)
# DATABASE_AUTH_TOKEN=
# 3. Local default: the SQLite file written by the CLI jobs.
DATABASE_PATH=./data/sclyio.db

# --- Publishing to Turso (CI / trusted machine only; never on Vercel) -------
# TURSO_API_TOKEN=             # Platform API token (turso auth api-tokens mint sclyio-ci)
# TURSO_ORG=                   # organization slug (turso org list)
# TURSO_GROUP=default
# TURSO_META_DB=sclyio-meta
# TURSO_DATASET_PREFIX=sclyio-data
# TURSO_KEEP=2

# --- Source (Duosmium) ------------------------------------------------------
DUOSMIUM_OWNER=Duosmium
DUOSMIUM_REPO=duosmium
DUOSMIUM_REF=main
# Offline import: path to a local checkout of the Duosmium `data` directory.
# DUOSMIUM_LOCAL_PATH=../duosmium/data
SOURCE_CACHE_DIR=.cache/duosmium
# Optional: raises GitHub API rate limits (3 API calls per sync). Read-only scope is enough.
# GITHUB_TOKEN=
FETCH_TIMEOUT_MS=30000
FETCH_RETRIES=4
FETCH_BACKOFF_MS=1000
FETCH_CONCURRENCY=4
# "all" = every season in the archive (default); "auto" = two most recent
# completed seasons + current; or a list such as 2025,2026.
IMPORT_SEASONS=all

# --- Site --------------------------------------------------------------------
# Where the /data page sends correction reports (e.g. a GitHub issues URL).
# Leave unset to offer a downloadable correction-details file instead.
# CORRECTIONS_URL=

# --- Accounts: Google sign-in, claims, Unofficial USR ------------------------
# Public origin of the site; builds the OAuth redirect URI
#   <APP_ORIGIN>/auth/google/callback
# Local: http://localhost:3000   Production: https://scly.io
APP_ORIGIN=http://localhost:3000
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (type "Web application").
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-client-secret
# Random secret, at least 32 characters (signs CSRF tokens and the OAuth state cookie):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# Writable accounts database (kept separate from the read-only result datasets).
# Local default: ./data/accounts.db. Production: a dedicated Turso database, e.g.
#   turso db create sclyio-accounts && turso db tokens create sclyio-accounts
# ACCOUNTS_DATABASE_URL=libsql://sclyio-accounts-<org>.<region>.turso.io
# ACCOUNTS_DATABASE_AUTH_TOKEN=
# ACCOUNTS_DATABASE_PATH=./data/accounts.db
